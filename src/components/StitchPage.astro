function updateAnchor(tag: string): string {
	const href = tag.match(/\bhref=(["'])(.*?)\1/i);
	const stitchPath = tag.match(/\bdata-path=(["'])(.*?)\1/i)?.[2];
	if (href && stitchPath && routeByStitchPath[stitchPath]) {
		return tag.replace(href[0], `href="${routeByStitchPath[stitchPath]}"`);
	}
	if (!href || href[2] !== '#') return tag;

	const label = tag
		.replace(/<[^>]*>/g, ' ')
		.replace(/&amp;/gi, '&')
		.replace(/\s+/g, ' ')
		.trim()
		.toLowerCase();
	let destination: string | undefined;

	if (label.includes('read dispatch')) destination = '/blog/';
	else if (label.includes('/rss.xml')) destination = '/rss.xml';
	else if (label.includes('architecture docs')) {
		destination = 'mailto:pksc.ceria@uic.edu.ph?subject=Request%20for%20Architecture%20Docs';
	} else if (label.includes('engineering cv') || label.includes('technical resume')) {
		destination = 'mailto:pksc.ceria@uic.edu.ph?subject=Request%20for%20Resume';
	}

	if (!destination) throw new Error(`Unmapped Stitch placeholder link: ${label}`);
	return tag.replace(href[0], `href="${destination}"`);
}

let integratedSource = source.replace(/<a\b[^>]*>[\s\S]*?<\/a>/gi, updateAnchor);
for (const [remoteSource, localSource] of Object.entries(imageSources)) {
	integratedSource = integratedSource.replaceAll(remoteSource, localSource);
}

const mobileItems = [
	{ label: 'Overview', href: '/' },
	{ label: 'Skills &amp; Tech', href: '/skills/' },
	{ label: 'Projects', href: '/projects/' },
	{ label: 'Engineering Log', href: '/engineering-log/' },
	{ label: 'Contact', href: '/contact/' },
];
const mobileNavigation = `<details class="relative xl:hidden"><summary aria-label="Open page navigation" class="list-none flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg bg-surface-container-high text-primary"><span class="material-symbols-outlined" aria-hidden="true">menu</span></summary><nav aria-label="Mobile navigation" class="absolute right-0 top-full z-[60] mt-2 grid min-w-56 gap-space-xs rounded-lg border border-outline-variant bg-surface-container-lowest p-space-sm shadow-xl">${mobileItems
	.map((item) => {
		const active = currentPath === item.href;
		const activeClass = active ? ' bg-surface-container text-primary font-semibold' : '';
		const ariaCurrent = active ? ' aria-current="page"' : '';
		return `<a class="block rounded-md px-space-md py-2 font-label-md text-label-md text-on-surface-variant hover:bg-surface-container hover:text-primary${activeClass}" href="${item.href}"${ariaCurrent}>${item.label}</a>`;
	})
	.join('')}</nav></details>`;

const desktopNavigation = /<nav\b(?=[^>]*data-active-classes)[^>]*>[\s\S]*?<\/nav>/i;
if (!desktopNavigation.test(integratedSource)) {
	throw new Error('Stitch page is missing the expected desktop navigation.');
}
integratedSource = integratedSource.replace(desktopNavigation, (nav) => `${nav}${mobileNavigation}`);

if (/href=(["'])#\1/i.test(integratedSource)) {
	throw new Error('Stitch page still contains a placeholder anchor.');
}
---

<Fragment set:html={integratedSource} />
