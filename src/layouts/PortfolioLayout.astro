---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	currentPath?: string;
}

const { title, description, currentPath = '' } = Astro.props;
const navItems = [
	{ label: 'Overview', href: '/' },
	{ label: 'Skills & Tech', href: '/skills/' },
	{ label: 'Projects', href: '/projects/' },
	{ label: 'Engineering Log', href: '/engineering-log/' },
	{ label: 'Contact', href: '/contact/' },
];
const email = 'princekurtgceria18@gmail.com';
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0c0814" />
		<title>{title} | Prince Kurt Sherlock G. Ceria</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="min-h-screen bg-brand-bg font-sans text-brand-text antialiased">
		<header class="sticky top-0 z-50 border-b border-brand-border bg-brand-bg/95 backdrop-blur-xl">
			<div class="mx-auto flex min-h-20 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
				<a href="/" class="flex min-w-0 items-center gap-3" aria-label="Prince Kurt Ceria home">
					<span
						class="relative grid h-11 w-11 shrink-0 place-items-center rounded-lg border border-brand-border-light bg-brand-surface text-brand-neon"
					>
						<span class="material-symbols-outlined" aria-hidden="true">terminal</span>
						<span class="absolute -bottom-1 -right-1 rounded bg-brand-bg px-1 font-mono text-[9px] text-brand-neon">
							PK
						</span>
					</span>
					<span class="min-w-0">
						<span class="block truncate text-sm font-semibold sm:text-base">Prince Kurt Sherlock G. Ceria</span>
						<span class="block truncate font-mono text-[10px] text-brand-muted">CpE · Software & Embedded Systems</span>
					</span>
				</a>

				<nav class="hidden items-center gap-4 xl:flex" aria-label="Main navigation">
					{navItems.map((item) => (
						<a
							href={item.href}
							aria-current={currentPath === item.href ? 'page' : undefined}
							class:list={[
								'whitespace-nowrap text-sm transition-colors hover:text-brand-neon',
								currentPath === item.href ? 'font-semibold text-brand-neon' : 'text-brand-muted',
							]}
						>
							{item.label}
						</a>
					))}
				</nav>

				<div class="hidden items-center gap-3 lg:flex">
					<span class="hidden items-center gap-2 rounded-lg bg-brand-surface px-3 py-2 font-mono text-[10px] text-brand-neon 2xl:flex">
						<span class="h-1.5 w-1.5 rounded-full bg-brand-neon"></span>
						4th Year CpE · Class of 2027
					</span>
					<a
						class="rounded-lg bg-brand-neon px-4 py-2.5 font-mono text-xs font-semibold text-brand-bg transition hover:-translate-y-0.5 hover:shadow-glow-neon"
						href="/contact/"
					>
						<span aria-hidden="true">&gt;</span> Get in Touch
					</a>
				</div>

				<details class="relative xl:hidden">
					<summary class="list-none cursor-pointer rounded-lg border border-brand-border px-3 py-2 font-mono text-xs text-brand-neon">
						<span class="material-symbols-outlined align-middle" aria-hidden="true">menu</span>
						<span class="sr-only">Open navigation menu</span>
					</summary>
					<nav
						class="absolute right-0 top-full mt-2 grid min-w-56 gap-1 rounded-xl border border-brand-border bg-brand-surface p-2 shadow-xl"
						aria-label="Mobile navigation"
					>
						{navItems.map((item) => (
							<a
								href={item.href}
								aria-current={currentPath === item.href ? 'page' : undefined}
								class:list={[
									'rounded-lg px-3 py-2 text-sm transition hover:bg-brand-elevated hover:text-brand-neon',
									currentPath === item.href ? 'font-semibold text-brand-neon' : 'text-brand-muted',
								]}
							>
								{item.label}
							</a>
						))}
						<a class="rounded-lg px-3 py-2 text-sm text-brand-muted hover:bg-brand-elevated hover:text-brand-neon" href="/about/">
							About
						</a>
					</nav>
				</details>
			</div>
		</header>

		<main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
			<slot />
		</main>

		<footer class="mt-10 border-t border-brand-border bg-brand-bg">
			<div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-8 text-sm sm:px-6 lg:px-8">
				<div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
					<div class="max-w-2xl">
						<p class="font-semibold text-brand-text">
							<span class="mr-2 inline-block h-2 w-2 rounded-full bg-brand-neon"></span>
							Prince Kurt Sherlock G. Ceria
						</p>
						<p class="mt-2 text-brand-muted">
							Computer Engineering student at the University of the Immaculate Conception, Davao.
							Interested in embedded systems, applied software, and practical engineering projects.
						</p>
					</div>
					<div class="flex flex-wrap gap-3 font-mono text-xs">
						<a class="rounded bg-brand-surface px-3 py-2 text-brand-muted hover:text-brand-neon" href="/about/">About</a>
						<a class="rounded bg-brand-surface px-3 py-2 text-brand-muted hover:text-brand-neon" href="https://github.com/Kurtieee" target="_blank" rel="noreferrer">GitHub</a>
						<a class="rounded bg-brand-surface px-3 py-2 text-brand-muted hover:text-brand-neon" href="https://www.linkedin.com/in/kurt-sherlock-ceria-b90443408/" target="_blank" rel="noreferrer">LinkedIn</a>
						<a class="rounded bg-brand-surface px-3 py-2 text-brand-muted hover:text-brand-neon" href={`mailto:${email}`}>Email</a>
					</div>
				</div>
				<div class="flex flex-col gap-2 border-t border-brand-border pt-4 font-mono text-[10px] text-brand-muted sm:flex-row sm:items-center sm:justify-between">
					<span>UIC Davao Computer Engineering · Class of 2027</span>
					<span>Built with Astro & Tailwind CSS</span>
				</div>
			</div>
		</footer>
	</body>
</html>
